# Copy to .env and fill in. Never commit .env.

# PostgreSQL password (generate one: openssl rand -base64 32)
KOS_DB_PASSWORD=

# Public URL where you open the app (must match exactly, scheme included).
KOS_APP_ORIGIN=https://knowledge.example.com

# true behind HTTPS (Caddy). Set to false only for local http://localhost testing.
KOS_COOKIE_SECURE=true

# Host port of the stack's gateway (bound to 127.0.0.1; your Caddy proxies to it).
KOS_HTTP_PORT=3000

# Maximum size of an uploaded file, in MB (the gateway accepts up to 250 MB).
KOS_MAX_UPLOAD_MB=200

# Memory limit for the worker container (Docling uses ~2 GB per document).
KOS_WORKER_MEM_LIMIT=4g

# Anthropic API key (console.anthropic.com). Without it, the AI features return a
# clear "no credentials" error; search and the library keep working.
ANTHROPIC_API_KEY=

# Default monthly AI spending limit in USD (editable in the app, page "IA").
KOS_AI_MONTHLY_BUDGET_USD=20
