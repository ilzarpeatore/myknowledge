# Copy to .env and fill in. Never commit .env.

# PostgreSQL password (generate one: openssl rand -hex 32). Hex only: it goes inside the
# database URL, where "/", "+" or "@" from base64 would break it.
KOS_DB_PASSWORD=

# Public URL where you open the app (must match exactly, scheme included).
KOS_APP_ORIGIN=https://knowledge.example.com

# true behind HTTPS (Caddy). Set to false only for local http://localhost testing.
KOS_COOKIE_SECURE=true

# Host port of the stack's gateway (bound to 127.0.0.1; your Caddy proxies to it).
KOS_HTTP_PORT=3000

# Maximum size of an uploaded file, in MB, and what the gateway lets through
# (keep it a bit higher). 4 GB fits a recorded class of 2-3 h. Your host proxy
# (Caddy, nginx…) needs the same body limit.
KOS_MAX_UPLOAD_MB=4000
KOS_GATEWAY_MAX_BODY=4100MB

# Memory limit for the worker container (Docling uses ~2 GB per document).
KOS_WORKER_MEM_LIMIT=4g

# Anthropic API key (console.anthropic.com). Without it, the AI features return a
# clear "no credentials" error; search and the library keep working.
ANTHROPIC_API_KEY=
# Clave maestra para guardar la clave de Anthropic desde la página IA (cifrada en la
# base de datos). Genérala una vez con: openssl rand -hex 32. Si la cambias, hay que
# volver a introducir la clave de Anthropic en la web.
KOS_SECRET_KEY=

# Default monthly AI spending limit in USD (editable in the app, page "IA").
KOS_AI_MONTHLY_BUDGET_USD=20

# Studies by DOI (Crossref; needs outbound HTTPS to api.crossref.org). Only the DOI
# is sent. Optional contact address for Crossref's faster "polite pool".
# KOS_CROSSREF_MAILTO=

# Alerts (`kos monitor`, `kos remind`; see DEPLOYMENT.md 4b): an ntfy topic URL
# (https://ntfy.sh/<topic>) or a Slack/Discord webhook. Empty: no alerts.
# KOS_ALERT_URL=
# KOS_PUBLIC_URL=https://conocimiento.tudominio.com

# Speech-to-text (worker). Model in the `whisper` volume: download it once with
#   docker compose run --rm -e HF_HUB_OFFLINE=0 worker kos download-whisper
# large-v3-turbo: best Spanish; ~26 min per hour of audio on 4 cores. "small": faster, worse.
KOS_WHISPER_MODEL=large-v3-turbo
KOS_WHISPER_THREADS=4
# Vacío = detectar el idioma (español, inglés...) en cada archivo. Pon «es» para forzarlo.
KOS_WHISPER_LANGUAGE=

# OCR de PDF: auto = solo en páginas sin texto (escaneos, portadas); all = también el
# texto dentro de imágenes de páginas con texto (más CPU).
KOS_PDF_OCR=auto
